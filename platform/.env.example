# Copy to .env.local for `vercel dev`. Never commit the real values.

# Postgres. Set automatically if you add Neon via the Vercel marketplace.
# POSTGRES_URL is accepted as an alternative name.
DATABASE_URL=postgres://...

# Shared secret between this platform and every sim it launches into.
# Must match LAUNCH_SECRET on each sim deployment. Generate a long random string.
LAUNCH_SECRET=change-me-to-something-long-and-random

# Optional. Invitation, reset and enrolment links normally follow whichever
# address the platform was reached at, so pointing a custom domain at the
# deployment needs no change here — links start using it immediately. Set this
# only to pin one canonical address regardless of how a page was reached.
# PUBLIC_BASE_URL=https://rapidsims.flexee.org

# Only needed once, to create the schema and the first admin at /setup.html.
# Delete it afterwards.
SETUP_KEY=some-long-random-string

# Dedicated operator diagnostics key. Same value on platform and sims; different from LAUNCH_SECRET.
HEALTH_SECRET=
