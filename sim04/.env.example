# Must match the RapidSims platform value.
LAUNCH_SECRET=
PLATFORM_URL=https://rapidsims.flexee.org
# Explicit canonical URL; never derive it from a request host.
SIM_URL=https://rapidsims.flexee.org/sim04
# For standalone students and faculty. Class launches use signed platform tokens.
ACCESS_CODE=
   # One entry per instructor, "Name:code", comma separated, codes 6+ characters.
   # A shared FACULTY_CODE is not supported and fails the health check.
   FACULTY_CODES=
# Upstash Redis REST (or the UPSTASH_REDIS_REST_* aliases).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared diagnostics secret, distinct from LAUNCH_SECRET.
HEALTH_SECRET=
