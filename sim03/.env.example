# Shared with the Flexee RapidSims platform.
LAUNCH_SECRET=

# Platform base URL, e.g. https://rapidsims.flexee.org
PLATFORM_URL=

# Canonical URL for this deployment. Avoid registering a Vercel preview URL.
SIM_URL=

# Optional standalone student access. Platform launch tokens bypass this.
ACCESS_CODE=

# Required for direct/standalone instructor access. Platform-launched faculty
# use a signed launch token instead. With neither a valid launch token nor a
# matching configured code, faculty API actions fail closed.
# FACULTY_CODES="Name:code,Other Name:code"
FACULTY_CODES=
# Legacy single-code fallback; prefer FACULTY_CODES.
FACULTY_CODE=

# Required for facilitated individual/team sessions and instructor analytics.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash-compatible alternatives are also accepted:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dedicated operator diagnostics key. Same value on platform and sims; different from LAUNCH_SECRET.
HEALTH_SECRET=
