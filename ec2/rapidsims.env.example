# Copy to /etc/rapidsims.env; optional /etc/rapidsims/<service>.env overrides it.
APP_ENV=production
PUBLIC_BASE_URL=https://rapidsims.flexee.org

# PostgreSQL and Redis run on this EC2 instance. Keep both bound to localhost.
DATABASE_URL=postgresql://rapidsims:CHANGE_ME@127.0.0.1:5432/rapidsims
REDIS_URL=redis://127.0.0.1:6379
# Dedicated durable outbox: identical on all simulations and the report worker.
REPORT_REDIS_URL=redis://127.0.0.1:6379/1

LAUNCH_SECRET=replace-with-a-long-random-secret
REPORT_SECRET=replace-with-a-distinct-long-random-report-secret
HEALTH_SECRET=replace-with-another-long-random-secret
SETUP_KEY=replace-with-a-one-time-setup-secret
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Leave standalone codes unset for account-only operation. Configure per service
# only when intentionally permitting standalone access outside portal enrolment.
# ACCESS_CODE=replace-with-student-access-code
# FACULTY_CODES="Jane Doe:replace-with-a-long-code"
# FACULTY_CODE=replace-with-a-long-faculty-code

# Platform diagnostics may contact only these HTTPS origins. PUBLIC_BASE_URL
# is also allowed. Do not add origins you do not operate.
HEALTH_ALLOWED_ORIGINS=https://rapidsims.flexee.org
# Local/staging only, explicitly permits private IPs and HTTP for listed origins:
# HEALTH_PRIVATE_ORIGINS=http://127.0.0.1:3101

# Optional canonical URL overrides; normally derived from PUBLIC_BASE_URL.
# SIM_URL_SIM01=https://rapidsims.flexee.org/sim01
# SIM_URL_SIM02=https://rapidsims.flexee.org/sim02
# SIM_URL_SIM03=https://rapidsims.flexee.org/sim03
# SIM_URL_SIM04=https://rapidsims.flexee.org/sim04
# SIM_URL_SIM05=https://rapidsims.flexee.org/sim05
# SIM_URL_SIM06=https://rapidsims.flexee.org/sim06
# SIM_URL_SIM07=https://rapidsims.flexee.org/sim07
# SIM_URL_SIM08=https://rapidsims.flexee.org/sim08
# SIM_URL_SIM09=https://rapidsims.flexee.org/sim09
# SIM_URL_SIM10=https://rapidsims.flexee.org/sim10
# SIM_URL_SIMPLUS01=https://rapidsims.flexee.org/sim-plus-01
# SIM_URL_SIMPLUS02=https://rapidsims.flexee.org/simplus02

