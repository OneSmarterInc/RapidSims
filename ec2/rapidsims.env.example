# Copy to /etc/rapidsims.env. All systemd services load this single file.
PUBLIC_BASE_URL=https://rapidsim.flexee.org

# PostgreSQL and Redis run on this EC2 instance. Keep both bound to localhost.
DATABASE_URL=postgresql://rapidsims:CHANGE_ME@127.0.0.1:5432/rapidsims
REDIS_URL=redis://127.0.0.1:6379

LAUNCH_SECRET=replace-with-a-long-random-secret
HEALTH_SECRET=replace-with-another-long-random-secret
SETUP_KEY=replace-with-a-one-time-setup-secret
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

ACCESS_CODE=replace-with-student-access-code
FACULTY_CODES="Jane Doe:replace-with-a-long-code,John Roe:replace-with-another-long-code"
FACULTY_CODE=replace-with-a-long-faculty-code

# Optional canonical URL overrides; normally derived from PUBLIC_BASE_URL.
# SIM_URL_SIM01=https://rapidsim.flexee.org/sim01
# SIM_URL_SIM02=https://rapidsim.flexee.org/sim02
