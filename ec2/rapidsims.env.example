# Copy to /etc/rapidsims.env and fill in real values. Keep this file out of Git.
# systemd reads this one file for the platform and every simulation process.

# Public site address. Use https:// after TLS is configured.
PUBLIC_BASE_URL=https://rapidsims.flexee.org

# Existing PostgreSQL database (the application currently uses Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Existing Upstash Redis REST database (session state for simulations).
KV_REST_API_URL=https://YOUR-REDIS.upstash.io
KV_REST_API_TOKEN=replace-with-token

# Shared signed-launch secret, identical across all apps.
LAUNCH_SECRET=replace-with-a-long-random-secret
# Dedicated operator diagnostics secret. Keep it different from LAUNCH_SECRET.
HEALTH_SECRET=replace-with-another-long-random-secret

# Platform first-run setup only. Remove from this file after creating the first admin.
SETUP_KEY=replace-with-a-one-time-setup-secret

# AI key required by RapidSim 01/02.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Optional standalone access codes; platform-launched users use signed tokens.
ACCESS_CODE=replace-with-student-access-code
FACULTY_CODES=Jane Doe:replace-with-a-long-code,John Roe:replace-with-another-long-code

# Optional per-simulation canonical URLs. Defaults are PUBLIC_BASE_URL + route.
# Set these only if a simulation has a dedicated domain.
# SIM_URL_SIM01=https://rapidsims.flexee.org/sim01
# SIM_URL_SIM02=https://rapidsims.flexee.org/sim02
# SIM_URL_SIM03=https://rapidsims.flexee.org/sim03
# SIM_URL_SIM04=https://rapidsims.flexee.org/sim04
# SIM_URL_SIM05=https://rapidsims.flexee.org/sim05
# SIM_URL_SIM06=https://rapidsims.flexee.org/sim06
# SIM_URL_SIM07=https://rapidsims.flexee.org/sim07
# SIM_URL_SIM08=https://rapidsims.flexee.org/sim08
# SIM_URL_SIM09=https://rapidsims.flexee.org/sim09
# SIM_URL_SIM10=https://rapidsims.flexee.org/sim10
# SIM_URL_SIMPLUS01=https://rapidsims.flexee.org/sim-plus-01
# SIM_URL_SIMPLUS02=https://rapidsims.flexee.org/simplus02
