[Unit]
Description=RapidSims durable result delivery
After=network-online.target

[Service]
Type=simple
User=rapidsims
Group=rapidsims
WorkingDirectory=/var/www/rapidsims-services/platform
EnvironmentFile=/etc/rapidsims.env
EnvironmentFile=-/etc/rapidsims/platform.env
ExecStart=/usr/bin/node /var/www/rapidsims-services/platform/ec2/report-worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
