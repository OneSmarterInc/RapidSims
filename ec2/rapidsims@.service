[Unit]
Description=Flexee RapidSims Node app (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rapidsims
Group=rapidsims
WorkingDirectory=/var/www/rapidsims-services/%i
EnvironmentFile=/etc/rapidsims.env
EnvironmentFile=-/etc/rapidsims/%i.env
EnvironmentFile=-/var/www/rapidsims-services/%i/release.env
ExecStart=/usr/bin/node /var/www/rapidsims-services/%i/ec2/server.js %i
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target

