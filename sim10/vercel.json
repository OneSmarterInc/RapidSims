{
  "ignoreCommand": "sh vercel-ignore.sh",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,data,lib}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
