# Shared with the Flexee RapidSims platform (same value as the platform's LAUNCH_SECRET).
LAUNCH_SECRET=

# Platform base URL, e.g. https://rapidsims.flexee.org  (registration and completion go here)
PLATFORM_URL=

# Canonical URL for this deployment, e.g. https://rapidsims.flexee.org/sim10
# Never a Vercel preview URL; never derived from the request host.
SIM_URL=

# Path prefix the platform rewrites to this project.
BASE_PATH=/sim10/

# Optional standalone access. Platform launch tokens bypass both. Unset = closed.
ACCESS_CODE=
# FACULTY_CODES="Name:code,Other Name:code"
FACULTY_CODES=

# Required for private solo play AND class sessions. Production fails closed
# without Redis; in-memory sessions are only available with local DEV_OPEN=1.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternatives to the KV pair:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local only. Never set on Vercel.
# DEV_OPEN=1
# SIM10_CLOCK_SCALE=0.05

# Dedicated operator diagnostics key. Same value on platform and sims; different from LAUNCH_SECRET.
HEALTH_SECRET=
