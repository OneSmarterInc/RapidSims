  "text_lines": [
    {
      "tag": "tx.amort_life",
      "section": "notes",
      "fact": "After discussion with the securities regulator, the company shortened the life over which it writes off one block of acquired goodwill from 10 years to 5, and restated earlier periods. No effect on cash.",
      "src": "gc-10q-2000q2 p.8 note 1; gc-10q-2000q3 p.8 note 1 (goodwill $1.5bn)"
    },
    {
      "tag": "tx.asset_lives",
      "section": "notes",
      "fact": "Network systems are depreciated over their remaining economic lives. The company's policy puts transmission equipment at 3 to 25 years.",
      "src": "gc-10q-2000q2 p.16; gc-10q-2000q3 p.17; 1999 10-K/A policy note (3-25 years)"
    },
    {
      "tag": "tx.deferral_shift",
      "section": "notes",
      "fact": "From this year most capacity contracts are booked as revenue spread over the contract term instead of up front. The company says this lowers reported revenue now, raises it later, and does not change cash.",
      "src": "gc-10q-2000q2 p.9-10 note 3; gc-10q-2000q3 p.9-10 note 3"
    },
    {
      "tag": "tx.customer_financing",
      "section": "notes",
      "fact": "The company has lent limited amounts to customers to help them buy capacity, repayable in instalments over up to four years, and says this will not materially affect its liquidity.",
      "src": "gc-10q-2000q2 p.22; gc-10q-2000q3 p.24"
    },
    {
      "tag": "tx.price_decline",
      "section": "notes",
      "fact": "Margins fell partly because of lower prices on the long-distance capacity the company sells.",
      "src": "gc-10q-2000q2 p.18 Cost of sales; gc-10q-2000q3 p.19 Cost of sales"
    },
    {
      "tag": "tx.losses_on_contracts",
      "section": "notes",
      "fact": "The company wrote down assets for expected losses on capacity sales contracts: $38m in Quarter 1, $3m in Quarter 2.",
      "src": "gc-10q-2000q2 p.10 note 3; gc-10q-2000q3 p.10 note 3"
    }
  ],
  "management_statements_source": [
    {
      "tag": "mg.strategy",
      "src": "gc-10q-2000q2 p.8 note 1",
      "gist": "Aims to be the leading provider of broadband data services over a network of unprecedented scope, and expects the network to make it the low-cost provider in most of its markets."
    },
    {
      "tag": "mg.demand",
      "src": "gc-10q-2000q2 p.18; gc-10q-2000q3 p.19",
      "gist": "Like-for-like revenue growth is driven mainly by rising demand for data products."
    },
    {
      "tag": "mg.funding",
      "src": "gc-10q-2000q3 p.23 Liquidity",
      "gist": "With the larger credit line, an affiliate's share sale and bond issue, the agreed business sale and expected operating cash, the company expects to fund all planned expansion without further financing."
    },
    {
      "tag": "mg.debt",
      "src": "gc-10q-2000q2 p.23; gc-10q-2000q3 p.24",
      "gist": "Has a substantial amount of debt; believes operating cash, the credit facility and its continued ability to raise capital will cover capital spending, interest and repayments for the foreseeable future."
    }
  ],
