# Copy to .env.local for `vercel dev`. Never commit the real values.

# Generates the characters. From console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Students need this to open the sim at all.
ACCESS_CODE=change-me

# One entry per faculty member, "Name:code", comma separated.
FACULTY_CODES=Jane Doe:jane-1234,John Roe:john-5678

# Set automatically by the Upstash Redis integration — do not set by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Shared with the platform, so launches from it are trusted. Must match the
# platform's LAUNCH_SECRET exactly. Leave unset to run the sim standalone.
LAUNCH_SECRET=

# Where to report a completion when a student finishes, so the platform can show
# faculty who has played. Leave unset when running the sim on its own.
PLATFORM_URL=https://rapidsims.flexee.org

# Session storage. Set automatically by the Upstash Redis integration — do not
# set by hand. UPSTASH_REDIS_REST_URL / _TOKEN are accepted as alternatives.

# The address this simulation should be reached at, used when it registers
# itself with the platform. Without it, whichever host the first request
# arrived on is used — which on Vercel may be a deployment-specific URL frozen
# to one build. Set it to the project's stable address.
SIM_URL=https://your-sim.vercel.app

# Dedicated operator diagnostics key. Same value on platform and sims; different from LAUNCH_SECRET.
HEALTH_SECRET=
